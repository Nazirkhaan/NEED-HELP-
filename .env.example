# ---- Backend ----

# Option A: Local Podman/Docker (default for development)
# DATABASE_URL=postgresql://sih:sih@localhost:5433/sih26044

# Option B: Neon managed Postgres (staging / production)
# Get this from: https://console.neon.tech → your project → Connection Details
# Use the DIRECT (non-pooled) connection string. sslmode=require is mandatory.
# DATABASE_URL=postgresql://<user>:<password>@ep-xxx.ap-south-1.aws.neon.tech/neondb?sslmode=require

DATABASE_URL=postgresql://sih:sih@localhost:5433/sih26044
JWT_SECRET=change-me-in-production
JWT_EXPIRES_MINUTES=720
CORS_ORIGINS=http://localhost:3000
# auto | fastembed | tfidf  (auto = try local embeddings, else TF-IDF fallback)
EMBEDDING_PROVIDER=auto

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000/api
